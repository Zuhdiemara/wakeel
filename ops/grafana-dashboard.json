{
 "title": "Wakeel",
 "uid": "wakeel",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus"
   }
  ]
 },
 "panels": [
  {
   "type": "timeseries",
   "title": "Cases by status (per hour)",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum by (status) (increase(wakeel_cases_total[1h]))",
     "legendFormat": "{{status}}"
    }
   ],
   "id": 1
  },
  {
   "type": "timeseries",
   "title": "Human decisions (per hour)",
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum by (approved) (increase(wakeel_decisions_total[1h]))",
     "legendFormat": "approved={{approved}}"
    }
   ],
   "id": 2
  },
  {
   "type": "stat",
   "title": "Reviewer rejection rate",
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum(increase(wakeel_decisions_total{approved=\"false\"}[1d])) / clamp_min(sum(increase(wakeel_decisions_total[1d])), 1)",
     "legendFormat": ""
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    }
   },
   "id": 3
  },
  {
   "type": "timeseries",
   "title": "p95 time per step",
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, node) (rate(wakeel_node_seconds_bucket[5m])))",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    }
   },
   "id": 4
  },
  {
   "type": "timeseries",
   "title": "Tokens per hour by provider",
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum by (provider) (increase(wakeel_llm_tokens_total[1h]))",
     "legendFormat": "{{provider}}"
    }
   ],
   "id": 5
  },
  {
   "type": "timeseries",
   "title": "Model errors and rules fallbacks",
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "rate(wakeel_llm_errors_total[5m])",
     "legendFormat": "errors/s"
    },
    {
     "expr": "sum by (node) (rate(wakeel_rules_fallback_total[5m]))",
     "legendFormat": "rules {{node}}"
    }
   ],
   "id": 6
  },
  {
   "type": "timeseries",
   "title": "Queue",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "wakeel_jobs",
     "legendFormat": "{{state}}"
    }
   ],
   "id": 7
  },
  {
   "type": "timeseries",
   "title": "Injection flags (per hour)",
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "increase(wakeel_injection_flags_total[1h])",
     "legendFormat": ""
    }
   ],
   "id": 8
  },
  {
   "type": "stat",
   "title": "Rules cross-checks (per day)",
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "increase(wakeel_cross_checks_total[1d])",
     "legendFormat": ""
    }
   ],
   "id": 9
  }
 ]
}