# Model providers. Gemini and Groq have free tiers; with both keys the default
# chain uses 7 free models (see DEFAULT_CHAIN in wakeel/llm.py).
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional: your own order, as vendor:model pairs. Vendors: gemini, groq,
# claude, openai, cerebras, openrouter, mistral, github.
# WAKEEL_MODELS=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite
# Optional free tiers, if you sign up: CEREBRAS_API_KEY, OPENROUTER_API_KEY,
# MISTRAL_API_KEY, GITHUB_MODELS_TOKEN (a GitHub token with models:read).
# Optional, paid: used after the free providers if set.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional: use a Daftar tenant as the bank's ledger instead of the in-memory demo.
DAFTAR_URL=
DAFTAR_KEY=
# Optional: require this token for reviewer decisions.
REVIEWER_TOKEN=
